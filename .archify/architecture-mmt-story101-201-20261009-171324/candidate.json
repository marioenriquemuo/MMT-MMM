  "cards": [
    {
      "dot": "cyan",
      "title": "1 · Practice data",
      "items": [
        "Four channels, day by day (Meta, Google, TikTok, TV)",
        "Sales = site-wide orders (same number on every channel that day)",
        "Locked fake export so everyone practices on the same file"
      ]
    },
    {
      "dot": "emerald",
      "title": "2 · Ad math helpers",
      "items": [
        "Shared formulas for “ads linger” and “extra spend helps less”",
        "Used to invent the practice data and draw teaching charts",
        "Charts open in a browser — no notebook required"
      ]
    },
    {
      "dot": "amber",
      "title": "3 · ETL + QA strip",
      "items": [
        "Fill missing partner-days; zero media pauses; forward-fill sales",
        "Ask: do impressions and clicks look normal vs recent days?",
        "If we cannot fix odd media, stop — do not train on a bad table"
      ]
    },
    {
      "dot": "violet",
      "title": "4 · Meridian fit",
      "items": [
        "Local pip library (google-meridian) — not a cloud API key call",
        "Daily table → national weeks → smoke chains, then fuller fit",
        "Fuller run must show chains agree (R-hat under 1.05)"
      ]
    },
    {
      "dot": "rose",
      "title": "Open finding",
      "items": [
        "Channel rank vs Path-C answer key is inconsistent (Spearman ≈ −0.6)",
        "Meridian order meta>tiktok>tv>google vs Path-C tv>google>meta>tiktok",
        "Status only for this spike — investigate scaling / priors / weeks later"
      ]
    }
  ]
}
