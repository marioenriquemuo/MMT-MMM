    {
      "dot": "cyan",
      "title": "What this step does",
      "items": [
        "Takes offline response curves (from Meridian metrics or a toy fixture)",
        "Picks spends that maximize lift under a budget, or hit a KPI with least spend",
        "Writes a structured plan JSON — or clears channels when the solve fails"
      ]
    },
    {
      "dot": "amber",
      "title": "Guardrails",
      "items": [
        "Min/max spend per channel must be feasible with the total budget",
        "After solving, re-check bounds and mode rules before accepting the plan",
        "On failure: channels is {} so nothing looks half-allocated"
      ]
    },
    {
      "dot": "rose",
      "title": "Caveat (from STORY-201)",
      "items": [
        "Allocator trusts the curves it is given",
        "Meridian channel ranks still disagree with Path-C (Spearman ≈ −0.6)",
        "Do not treat allocations as Path-C ground truth"
      ]
    }
  ]
