  "cards": [
    {
      "dot": "cyan",
      "title": "1 \u00b7 Practice data",
      "items": [
        "Four channels, day by day (Meta, Google, TikTok, TV)",
        "Sales = site-wide orders (same number on every channel that day)",
        "Locked fake export so everyone practices on the same file"
      ]
    },
    {
      "dot": "emerald",
      "title": "2 \u00b7 Ad math helpers",
      "items": [
        "Shared formulas for \u201cads linger\u201d and \u201cextra spend helps less\u201d",
        "Used to invent the practice data and draw teaching charts",
        "Charts open in a browser \u2014 no notebook required"
      ]
    },
    {
      "dot": "amber",
      "title": "3 \u00b7 Clean the export",
      "items": [
        "Partner files often skip idle days \u2014 we put those days back",
        "Missing spend/impressions/clicks become zero (pause), not invented spend",
        "Missing sales carry forward from the last known day"
      ]
    },
    {
      "dot": "violet",
      "title": "4 \u00b7 Check media quality",
      "items": [
        "Ask: do impressions and clicks look normal vs recent days?",
        "If history is strong enough, fix the odd day (never change spend)",
        "If we cannot fix it, stop \u2014 do not upload a bad training table"
      ]
    },
    {
      "dot": "rose",
      "title": "Next",
      "items": [
        "Story 201: fit the budget model on the clean table",
        "Model reads levels after QA \u2014 not the raw holes",
        "Same helpers stay shared for decay / saturation"
      ]
    }
  ]
}
