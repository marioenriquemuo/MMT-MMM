  "cards": [
    {
      "dot": "amber",
      "title": "How to read the numbers",
      "items": [
        "Figures are incremental KPI, not revenue dollars.",
        "Meridian channel rank vs Path-C is still open.",
        "Do not treat the plan or the brief as Path-C ground truth."
      ]
    },
    {
      "dot": "cyan",
      "title": "What is built",
      "items": [
        "Practice spend is lined up, checked, and fit with Meridian.",
        "The search writes a spend plan, or clears channels when it fails.",
        "Sliders rerun the local allocator, charts, and offline commentary.",
        "Update insights is the only dashboard step that calls Claude."
      ]
    }
  ]
